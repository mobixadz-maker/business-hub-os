+        workflow = workflow_service.resume(db, workflow, user)
+    except ValueError as exc:
+        raise HTTPException(status_code=409, detail=str(exc)) from exc
+    return serialize(workflow, db)
diff --git a/core/agent_run_service.py b/core/agent_run_service.py
