@@ -0,0 +1,66 @@
+from fastapi import APIRouter, Depends, Header, HTTPException
+from sqlalchemy.orm import Session
+from core.agent_run_service import agent_run_service
+from core.database import get_db
+from core.schemas import AgentRunApproval, AgentRunCreate
+from core.security import current_user, require_roles
+
+router = APIRouter(tags=["agent-runs"])
+
+
+def serialize(run):
+    return {
+        "id": run.id, "agent_id": run.agent_id, "requested_by": run.requested_by,
+        "status": run.status, "tool_name": run.tool_name, "input_data": run.input_json,
+        "output": run.output_json, "requires_approval": run.requires_approval,
+        "approval_status": run.approval_status, "approved_by": run.approved_by,
+        "approval_reason": run.approval_reason, "error": run.error_message,
+        "created_at": run.created_at, "updated_at": run.updated_at,
+    }
+
+
+@router.post("/agents/{agent_id}/runs", status_code=201)
+def create_agent_run(
+    agent_id: str, payload: AgentRunCreate, db: Session = Depends(get_db),
+    user=Depends(require_roles("owner", "admin", "manager", "analyst")),
+    idempotency_key: str | None = Header(default=None, alias="Idempotency-Key"),
+):
+    if idempotency_key and len(idempotency_key) > 128:
+        raise HTTPException(status_code=422, detail="Idempotency-Key must be at most 128 characters")
+    try:
+        run = agent_run_service.create(db, agent_id, user, payload, idempotency_key)
+    except LookupError as exc:
+        raise HTTPException(status_code=404, detail=str(exc)) from exc
+    except PermissionError as exc:
+        raise HTTPException(status_code=403, detail=str(exc)) from exc
+    return serialize(run)
+
+
+@router.get("/agent-runs")
+def list_agent_runs(db: Session = Depends(get_db), user=Depends(current_user)):
+    return [serialize(run) for run in agent_run_service.list_for_user(db, user)]
+
+
+@router.get("/agent-runs/{run_id}")
+def get_agent_run(run_id: str, db: Session = Depends(get_db), user=Depends(current_user)):
+    run = agent_run_service.get(db, run_id)
+    if run is None:
+        raise HTTPException(status_code=404, detail="Agent run not found")
+    if user.role not in {"owner", "admin", "manager"} and run.requested_by != user.id:
+        raise HTTPException(status_code=404, detail="Agent run not found")
+    return serialize(run)
+
+
+@router.post("/agent-runs/{run_id}/approval")
+def decide_agent_run(
+    run_id: str, payload: AgentRunApproval, db: Session = Depends(get_db),
+    user=Depends(require_roles("owner", "admin", "manager")),
+):
+    run = agent_run_service.get(db, run_id)
+    if run is None:
+        raise HTTPException(status_code=404, detail="Agent run not found")
+    try:
+        run = agent_run_service.decide(db, run, user, payload.decision.value, payload.reason)
+    except ValueError as exc:
+        raise HTTPException(status_code=409, detail=str(exc)) from exc
+    return serialize(run)
