index 0000000..6c947c2
--- /dev/null
+++ b/core/agent_run_service.py
@@ -0,0 +1,92 @@
+"""Persistent, deny-by-default agent execution service.
+
+This sprint deliberately ships a deterministic local executor. External side effects
+remain unavailable until a separately reviewed integration is configured.
+"""
+from uuid import uuid4
+from sqlalchemy.orm import Session
+from core.audit import audit_log
+from core.models import AgentRunRecord
+from core.policies import TOOL_POLICIES, is_tool_allowed
+from core.registry import agent_registry
+
+SAFE_EXECUTORS = {
+    "catalog.read": lambda data: {"mode": "simulated", "message": "Catalog read adapter is not configured.", "input": data},
+    "report.generate": lambda data: {"mode": "simulated", "message": "Report adapter is not configured.", "input": data},
+}
+
+
+class AgentRunService:
+    def create(self, db: Session, agent_id: str, user, payload, idempotency_key: str | None = None):
+        if idempotency_key:
+            existing = db.query(AgentRunRecord).filter_by(idempotency_key=idempotency_key).first()
+            if existing:
+                if existing.requested_by != user.id:
+                    raise PermissionError("Idempotency key belongs to another user")
+                return existing
+
+        agent = agent_registry.get(agent_id)
+        if agent is None:
+            raise LookupError("Agent not found")
+        tool_name = payload.tool_name
+        if tool_name:
+            if tool_name not in agent.allowed_tools or not is_tool_allowed(tool_name, agent.department):
+                raise PermissionError("Tool is not permitted for this agent")
+            policy = TOOL_POLICIES[tool_name]
+            requires_approval = policy.requires_approval
+        else:
+            requires_approval = False
+
+        run = AgentRunRecord(
+            id=str(uuid4()), agent_id=agent_id, requested_by=user.id,
+            status="waiting_approval" if requires_approval else "completed",
+            input_json=payload.input_data, output_json=None, tool_name=tool_name,
+            requires_approval=requires_approval,
+            approval_status="pending" if requires_approval else None,
+            idempotency_key=idempotency_key,
+        )
+        if not requires_approval:
+            executor = SAFE_EXECUTORS.get(tool_name) if tool_name else None
+            run.output_json = executor(payload.input_data) if executor else {
+                "mode": "no_tool", "message": "Agent run recorded; no tool was invoked."}
+        db.add(run)
+        audit_log.record(db, "agent_run.created", run.id, {
+            "agent_id": agent_id, "tool_name": tool_name, "status": run.status,
+            "requires_approval": requires_approval,
+        })
+        db.commit()
+        db.refresh(run)
+        return run
+
+    def decide(self, db: Session, run: AgentRunRecord, user, decision: str, reason: str = ""):
+        if run.status != "waiting_approval":
+            raise ValueError("Run is not awaiting approval")
+        run.approval_status = decision
+        run.approved_by = user.email
+        run.approval_reason = reason
+        if decision == "rejected":
+            run.status = "failed"
+            run.error_message = "Execution rejected by an authorized reviewer."
+        else:
+            # Approval is recorded, but this release does not execute external side effects.
+            run.status = "approved"
+            run.output_json = {"mode": "approval_only", "message":
+                "Approved. External execution remains disabled until an integration is configured."}
+        audit_log.record(db, f"agent_run.{decision}", run.id, {
+            "approved_by": user.email, "reason": reason, "tool_name": run.tool_name,
+        })
+        db.commit()
+        db.refresh(run)
+        return run
+
+    def get(self, db: Session, run_id: str):
+        return db.get(AgentRunRecord, run_id)
+
+    def list_for_user(self, db: Session, user, limit: int = 100):
+        query = db.query(AgentRunRecord)
+        if user.role not in {"owner", "admin", "manager"}:
+            query = query.filter(AgentRunRecord.requested_by == user.id)
+        return query.order_by(AgentRunRecord.created_at.desc()).limit(limit).all()
+
+
+agent_run_service = AgentRunService()
