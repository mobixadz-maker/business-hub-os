@@ -0,0 +1,66 @@
+import re
+from uuid import uuid4
+from fastapi import APIRouter, Depends, HTTPException
+from pydantic import BaseModel, Field
+from sqlalchemy.orm import Session
+from sqlalchemy import or_
+from core.audit import audit_log
+from core.database import get_db
+from core.models import AgentMemoryRecord
+from core.registry import agent_registry
+from core.security import require_roles
+
+router = APIRouter(tags=["agent-memory"])
+SECRET_PATTERN = re.compile(r"(?i)(api[_ -]?key|secret|password|bearer\s+[a-z0-9._-]{12,}|sk-[a-z0-9]{16,})")
+
+class MemoryCreate(BaseModel):
+    content: str = Field(min_length=3, max_length=2000)
+    visibility: str = Field(default="shared", pattern="^(shared|private)$")
+    memory_type: str = Field(default="fact", min_length=2, max_length=40)
+    importance: int = Field(default=3, ge=1, le=5)
+
+def serialize(item):
+    return {"id": item.id, "agent_id": item.agent_id, "visibility": item.visibility,
+            "memory_type": item.memory_type, "content": item.content,
+            "importance": item.importance, "status": item.status,
+            "created_at": item.created_at, "updated_at": item.updated_at}
+
+@router.post("/agents/{agent_id}/memory", status_code=201)
+def add_memory(agent_id: str, payload: MemoryCreate, db: Session = Depends(get_db),
+               user=Depends(require_roles("owner", "admin", "manager", "analyst"))):
+    if agent_registry.get(agent_id) is None:
+        raise HTTPException(status_code=404, detail="Agent not found")
+    if SECRET_PATTERN.search(payload.content):
+        raise HTTPException(status_code=422, detail="Memory cannot contain credentials or secrets")
+    item = AgentMemoryRecord(id=str(uuid4()), agent_id=agent_id,
+        owner_user_id=user.id if payload.visibility == "private" else None,
+        visibility=payload.visibility, memory_type=payload.memory_type,
+        content=payload.content, importance=payload.importance, status="active")
+    db.add(item)
+    audit_log.record(db, "agent_memory.created", item.id, {"agent_id": agent_id,
+        "visibility": item.visibility, "memory_type": item.memory_type})
+    db.commit(); db.refresh(item)
+    return serialize(item)
+
+@router.get("/agents/{agent_id}/memory")
+def list_memory(agent_id: str, db: Session = Depends(get_db),
+                user=Depends(require_roles("owner", "admin", "manager", "analyst"))):
+    if agent_registry.get(agent_id) is None:
+        raise HTTPException(status_code=404, detail="Agent not found")
+    query = db.query(AgentMemoryRecord).filter(AgentMemoryRecord.agent_id == agent_id,
+        AgentMemoryRecord.status == "active")
+    query = query.filter(or_(AgentMemoryRecord.visibility == "shared",
+        AgentMemoryRecord.owner_user_id == user.id))
+    return [serialize(item) for item in query.order_by(AgentMemoryRecord.importance.desc(),
+        AgentMemoryRecord.created_at.desc()).limit(50).all()]
+
+@router.post("/agent-memory/{memory_id}/archive")
+def archive_memory(memory_id: str, db: Session = Depends(get_db),
+                   user=Depends(require_roles("owner", "admin", "manager", "analyst"))):
+    item = db.get(AgentMemoryRecord, memory_id)
+    if item is None or (item.visibility == "private" and item.owner_user_id != user.id and user.role not in {"owner", "admin"}):
+        raise HTTPException(status_code=404, detail="Memory not found")
+    item.status = "archived"
+    audit_log.record(db, "agent_memory.archived", item.id, {"agent_id": item.agent_id})
+    db.commit()
+    return {"id": item.id, "status": item.status}
