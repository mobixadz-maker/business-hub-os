--- /dev/null
+++ b/core/ai_runtime.py
@@ -0,0 +1,59 @@
+"""Provider-neutral AI runtime. Sprint 7 ships offline adapters only; live calls stay disabled."""
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from typing import Protocol
+
+
+@dataclass(frozen=True)
+class Generation:
+    text: str
+    input_tokens: int
+    output_tokens: int
+
+
+class Provider(Protocol):
+    name: str
+    model: str
+    price_input_per_1k: float
+    price_output_per_1k: float
+
+    def generate(self, prompt: str, max_output_tokens: int) -> Generation: ...
+
+
+class MockProvider:
+    def __init__(self, name: str, model: str, input_rate: float, output_rate: float):
+        self.name, self.model = name, model
+        self.price_input_per_1k, self.price_output_per_1k = input_rate, output_rate
+
+    def generate(self, prompt: str, max_output_tokens: int) -> Generation:
+        # Intentionally deterministic and offline; never calls an external model.
+        answer = f"[SIMULATED:{self.name}/{self.model}] {prompt[:1200]}"
+        input_tokens = max(1, (len(prompt) + 3) // 4)
+        output_tokens = min(max_output_tokens, max(1, (len(answer) + 3) // 4))
+        return Generation(answer, input_tokens, output_tokens)
+
+
+class ModelRouter:
+    def __init__(self):
+        self.providers: dict[str, Provider] = {
+            "openai": MockProvider("openai", "mock-gpt", 0.0015, 0.002),
+            "anthropic": MockProvider("anthropic", "mock-claude", 0.003, 0.015),
+            "google": MockProvider("google", "mock-gemini", 0.00035, 0.00105),
+        }
+        self.task_defaults = {
+            "research": "google", "classification": "google", "creative": "openai",
+            "analysis": "anthropic", "support": "openai", "general": "openai",
+        }
+
+    def choose(self, task: str, requested_provider: str | None = None) -> Provider:
+        name = requested_provider or self.task_defaults.get(task, self.task_defaults["general"])
+        if name not in self.providers:
+            raise LookupError("Unknown AI provider")
+        return self.providers[name]
+
+    def list_providers(self):
+        return [{"id": p.name, "model": p.model, "mode": "mock", "live_enabled": False}
+                for p in self.providers.values()]
+
+
+model_router = ModelRouter()
