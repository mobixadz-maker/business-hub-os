diff --git a/core/workflow_service.py b/core/workflow_service.py
new file mode 100644
index 0000000..2b148dd
--- /dev/null
+++ b/core/workflow_service.py
@@ -0,0 +1,132 @@
+"""Durable sequential workflow orchestration for the controlled agent runtime."""
+from uuid import uuid4
+from sqlalchemy.orm import Session
+from core.agent_run_service import agent_run_service
+from core.audit import audit_log
+from core.models import WorkflowRunRecord, WorkflowStepRecord
+
+
+class WorkflowService:
+    def create(self, db: Session, user, payload):
+        workflow = WorkflowRunRecord(
+            id=str(uuid4()), name=payload.name, requested_by=user.id,
+            status="running", current_step=0,
+        )
+        db.add(workflow)
+        for index, item in enumerate(payload.steps):
+            db.add(WorkflowStepRecord(
+                id=str(uuid4()), workflow_run_id=workflow.id, position=index,
+                agent_id=item.agent_id, tool_name=item.tool_name,
+                input_json=item.input_data, status="pending",
+            ))
+        audit_log.record(db, "workflow.created", workflow.id, {
+            "name": workflow.name, "step_count": len(payload.steps),
+        })
+        db.commit()
+        db.refresh(workflow)
+        return self._advance(db, workflow, user)
+
+    def _advance(self, db: Session, workflow: WorkflowRunRecord, user):
+        steps = (db.query(WorkflowStepRecord)
+                 .filter_by(workflow_run_id=workflow.id)
+                 .order_by(WorkflowStepRecord.position.asc()).all())
+        for step in steps:
+            if step.status != "pending":
+                continue
+            try:
+                run = agent_run_service.create(
+                    db, step.agent_id, user,
+                    _StepPayload(step.tool_name, step.input_json),
+                    idempotency_key=f"workflow:{workflow.id}:step:{step.position}",
+                )
+            except (LookupError, PermissionError) as exc:
+                step.status = "failed"
+                step.error_message = str(exc)
+                workflow.status = "failed"
+                workflow.error_message = str(exc)
+                audit_log.record(db, "workflow.failed", workflow.id, {
+                    "step": step.position, "error": str(exc),
+                })
+                db.commit()
+                return workflow
+            step.agent_run_id = run.id
+            step.status = "waiting_approval" if run.status == "waiting_approval" else run.status
+            step.output_json = run.output_json
+            workflow.current_step = step.position
+            if run.status == "waiting_approval":
+                workflow.status = "waiting_approval"
+                audit_log.record(db, "workflow.waiting_approval", workflow.id, {
+                    "step": step.position, "agent_run_id": run.id,
+                })
+                db.commit()
+                db.refresh(workflow)
+                return workflow
+            if run.status != "completed":
+                step.status = "failed"
+                step.error_message = run.error_message or f"Agent run ended as {run.status}"
+                workflow.status = "failed"
+                workflow.error_message = step.error_message
+                db.commit()
+                return workflow
+            db.commit()
+        workflow.status = "completed"
+        workflow.current_step = len(steps)
+        audit_log.record(db, "workflow.completed", workflow.id, {"step_count": len(steps)})
+        db.commit()
+        db.refresh(workflow)
+        return workflow
+
+    def resume(self, db: Session, workflow: WorkflowRunRecord, user):
+        if workflow.status != "waiting_approval":
+            raise ValueError("Workflow is not waiting for approval")
+        steps = (db.query(WorkflowStepRecord)
+                 .filter_by(workflow_run_id=workflow.id)
+                 .order_by(WorkflowStepRecord.position.asc()).all())
+        current = next((s for s in steps if s.position == workflow.current_step), None)
+        if current is None or not current.agent_run_id:
+            raise ValueError("Workflow approval step is missing its agent run")
+        from core.models import AgentRunRecord
+        run = db.get(AgentRunRecord, current.agent_run_id)
+        if run is None or run.status == "waiting_approval":
+            raise ValueError("Agent run approval has not been decided")
+        if run.status != "approved":
+            current.status = "failed"
+            current.error_message = "Agent run was rejected."
+            workflow.status = "failed"
+            workflow.error_message = current.error_message
+            db.commit()
+            return workflow
+        # Approval is not execution: external actions remain disabled in this release.
+        current.status = "approved_not_executed"
+        current.output_json = run.output_json
+        workflow.status = "paused_approved_not_executed"
+        workflow.error_message = "Approval recorded; external execution is disabled."
+        audit_log.record(db, "workflow.paused_after_approval", workflow.id, {
+            "agent_run_id": run.id, "step": current.position,
+        })
+        db.commit()
+        db.refresh(workflow)
+        return workflow
+
+    def get(self, db: Session, workflow_id: str):
+        return db.get(WorkflowRunRecord, workflow_id)
+
+    def list_for_user(self, db: Session, user):
+        query = db.query(WorkflowRunRecord)
+        if user.role not in {"owner", "admin", "manager"}:
+            query = query.filter(WorkflowRunRecord.requested_by == user.id)
+        return query.order_by(WorkflowRunRecord.created_at.desc()).limit(100).all()
+
+    def steps(self, db: Session, workflow_id: str):
+        return (db.query(WorkflowStepRecord)
+                .filter_by(workflow_run_id=workflow_id)
+                .order_by(WorkflowStepRecord.position.asc()).all())
+
+
+class _StepPayload:
+    def __init__(self, tool_name, input_data):
+        self.tool_name = tool_name
+        self.input_data = input_data
+
+
+workflow_service = WorkflowService()
